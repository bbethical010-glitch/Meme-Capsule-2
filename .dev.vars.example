# Local Development Variables
# Rename this file to .dev.vars to use with wrangler

# Used for authenticating against the /api/admin/* backend routes
ADMIN_API_TOKEN="MEME@67"

# Used by the frontend AdminGate to restrict access to the dashboard
VITE_ADMIN_PIN="123456"

# Required by POST /api/analytics/events for Android telemetry ingestion
ANALYTICS_APP_TOKEN="replace-with-a-rotated-app-token"
